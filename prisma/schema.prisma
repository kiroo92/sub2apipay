generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ActivityRewardStatus {
  PENDING
  ISSUED
  ISSUE_FAILED
}

model ActivityDrawRecord {
  id                  String               @id @default(cuid())
  activityKey         String               @map("activity_key")
  userId              Int                  @map("user_id")
  rechargeOrderCount  Int                  @default(0) @map("recharge_order_count")
  totalRechargeAmount Decimal              @db.Decimal(10, 2) @map("total_recharge_amount")
  prizeKey            String               @map("prize_key")
  prizeSlot           Int?                 @map("prize_slot")
  prizeName           String               @map("prize_name")
  prizeAmount         Decimal              @db.Decimal(10, 2) @map("prize_amount")
  issueStatus         ActivityRewardStatus @default(PENDING) @map("issue_status")
  issueError          String?              @db.Text @map("issue_error")
  issuedAt            DateTime?            @map("issued_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([activityKey, userId])
  @@unique([activityKey, prizeKey, prizeSlot])
  @@index([activityKey, userId])
  @@index([userId, createdAt])
  @@map("activity_draw_records")
}
