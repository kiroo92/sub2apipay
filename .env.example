# PostgreSQL
DATABASE_URL="postgresql://activity:password@localhost:5432/activity"

# Docker Compose
# Required by docker-compose.yml and docker-compose.hub.yml. Use URL-safe characters.
DB_PASSWORD="replace-with-a-long-random-password"
APP_HOST="127.0.0.1"
APP_PORT="3001"
LOG_MAX_SIZE="10m"
LOG_MAX_FILE="3"
# Optional image override for prebuilt-image deployments:
# APP_IMAGE="ghcr.io/kiroo92/sub2apipay"
# IMAGE_TAG="latest"
# Required only by docker-compose.prod.yml:
# SUB2API_DOCKER_NETWORK="sub2api-star_sub2api-network"

# Sub2API
SUB2API_BASE_URL="https://your-sub2api-domain.com"
SUB2API_ADMIN_API_KEY="your-sub2api-admin-api-key"

# Admin
ADMIN_TOKEN="your-very-long-admin-token"

# App
NEXT_PUBLIC_APP_URL="https://activity.example.com"
LOTTERY_START_AT="2026-08-01T00:00:00+08:00"
LOTTERY_END_AT="2026-09-01T00:00:00+08:00"
LOTTERY_ADMIN_CONTACT="support@example.com"
LOTTERY_VOUCHER_REDEMPTION_DAYS="7"
